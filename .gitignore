# ── SECRETOS ──────────────────────────────────────────────────
#
# application-local.yml lleva la contrasena de PostgreSQL, el TICKET_SECRET que
# firma los QR de las entradas y el AUTH_SECRET que firma las sesiones. Nunca
# a git.
#
# Estaba protegido por el .gitignore de la raiz cuando backend y frontend vivian
# en el mismo repositorio. Al separarlos, ese archivo dejo de existir y este
# quedo sin cubrirlo: se detecto antes del primer push.
application-local.yml
application-local.properties
.env
.env.local

# ── Flyers subidos desde el panel (datos, no codigo) ─────────


# ── Datos de muestra ──────────────────────────────────────────
# El generador sí va a git; lo que produce no: poblar.sql pesa 21 MB y se
# regenera igual, y el respaldo lleva datos personales de clientes reales.
datos/poblar.sql
datos/poblar-noviembre.sql
datos/*.dump

